# Copy to .env and fill in. Never commit the real file.
# API key from https://fxapis.com (console -> API keys). Test keys reach real brokers: use a broker DEMO account.
FXAPIS_API_KEY=fx_test_replace_me

# quickstart: an MT5 demo account to connect (or FXAPIS_ACCOUNT_ID of one already connected)
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=
FXAPIS_ACCOUNT_ID=

# Set to 1 to let the examples place (and close) a 0.01-lot demo trade. Without it they only read.
FXAPIS_EXAMPLES_TRADE=0

# copy trader: the master account and the followers (comma separated fxapis account ids)
MASTER_ACCOUNT_ID=
FOLLOWER_ACCOUNT_IDS=
VOLUME_MULTIPLIER=1.0
